generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoleKey {
  OWNER
  ADMIN
  FINANCE_STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum BrandStatus {
  ACTIVE
  INACTIVE
}

enum AccountCategory {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  COST_OF_GOODS_SOLD
  EXPENSE
  OTHER_INCOME
  OTHER_EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum TransactionType {
  INCOME
  EXPENSE
  CLIENT_DP
  CLIENT_SETTLEMENT
  PRODUCTION_COST
  EQUIPMENT_PURCHASE
  MARKETING
  SALARY
  TRANSPORT
  UTILITY
  RENT
  OWNER_DRAW
  CASH_ADJUSTMENT
  VENDOR_PAYMENT
  ASSET_DEPRECIATION
}

enum TransactionStatus {
  DRAFT
  POSTED
  VOID
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

enum VendorBillStatus {
  DRAFT
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

enum ProjectStatus {
  LEAD
  BOOKED
  ONGOING
  DONE
  CANCELLED
  UNPAID
  DP
  PARTIAL
  PAID
}

enum AssetCategory {
  CAMERA
  LENS
  LIGHTING
  COMPUTER
  STUDIO_PROP
  WARDROBE
  FURNITURE
  MAKEUP_EQUIPMENT
  OTHER
}

enum AssetCondition {
  EXCELLENT
  GOOD
  FAIR
  NEEDS_REPAIR
  RETIRED
}

enum AttachmentKind {
  TRANSACTION_PROOF
  INVOICE_DOC
  VENDOR_BILL_DOC
  ASSET_DOC
  OTHER
}

enum ActivityAction {
  LOGIN
  CREATE
  UPDATE
  DELETE
  EXPORT
}

enum ProjectPaymentStatus {
  UNPAID
  DP
  PARTIAL
  PAID
}

model Role {
  id          String   @id @default(cuid())
  key         RoleKey  @unique
  name        String
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id                 String            @id @default(cuid())
  name               String
  email              String            @unique
  passwordHash       String
  status             UserStatus        @default(ACTIVE)
  roleId             String
  allBrandsAccess    Boolean           @default(false)
  lastLoginAt        DateTime?
  role               Role              @relation(fields: [roleId], references: [id])
  brandAccesses      UserBrandAccess[]
  enteredTransactions Transaction[]    @relation("TransactionEnteredBy")
  updatedTransactions Transaction[]    @relation("TransactionUpdatedBy")
  activities         ActivityLog[]
  attachments        Attachment[]      @relation("AttachmentUploadedBy")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model UserBrandAccess {
  id        String   @id @default(cuid())
  userId    String
  brandId   String
  canView   Boolean  @default(true)
  canManage Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, brandId])
}

model Brand {
  id               String             @id @default(cuid())
  code             String             @unique
  name             String
  slug             String             @unique
  color            String?
  description      String?
  status           BrandStatus        @default(ACTIVE)
  accounts         Account[]
  transactions     Transaction[]
  invoices         Invoice[]
  vendorBills      VendorBill[]
  assets           Asset[]
  projects         Project[]
  activityLogs     ActivityLog[]
  userAccesses     UserBrandAccess[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model TransactionCategory {
  id                 String            @id @default(cuid())
  code               String            @unique
  name               String
  transactionType    TransactionType
  accountCategory    AccountCategory
  description        String?
  isSystem           Boolean           @default(false)
  transactions       Transaction[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model Account {
  id             String          @id @default(cuid())
  code           String          @unique
  name           String
  category       AccountCategory
  normalBalance  NormalBalance
  description    String?
  isSystem       Boolean         @default(false)
  brandId        String?
  brand          Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  transactions   Transaction[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Client {
  id          String        @id @default(cuid())
  name        String
  companyName String?
  email       String?
  phone       String?
  address     String?
  notes       String?
  projects    Project[]
  invoices    Invoice[]
  transactions Transaction[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Vendor {
  id           String        @id @default(cuid())
  name         String
  email        String?
  phone        String?
  address      String?
  notes        String?
  vendorBills  VendorBill[]
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model PaymentMethod {
  id           String        @id @default(cuid())
  code         String
  name         String
  type         String?
  accountName  String?
  accountNo    String?
  isCash       Boolean       @default(false)
  notes        String?
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([code])
}

model Project {
  id               String         @id @default(cuid())
  projectCode      String         @unique
  name             String
  brandId          String
  clientId         String
  projectDate      DateTime
  value            Decimal        @default(0) @db.Decimal(18, 2)
  status           ProjectStatus  @default(LEAD)
  recognizedIncome Decimal        @default(0) @db.Decimal(18, 2)
  recognizedCost   Decimal        @default(0) @db.Decimal(18, 2)
  profit           Decimal        @default(0) @db.Decimal(18, 2)
  notes            String?
  brand            Brand          @relation(fields: [brandId], references: [id], onDelete: Restrict)
  client           Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  transactions     Transaction[]
  invoices         Invoice[]
  vendorBills      VendorBill[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  totalValue         Decimal   @default(0) @db.Decimal(18, 2)
  amountPaid         Decimal   @default(0) @db.Decimal(18, 2)
  outstandingAmount  Decimal   @default(0) @db.Decimal(18, 2)
  paymentStatus      ProjectPaymentStatus @default(UNPAID)

  @@index([brandId, projectDate])
}

model Invoice {
  id                String         @id @default(cuid())
  invoiceNo         String         @unique
  invoiceDate       DateTime
  brandId           String
  clientId          String
  projectId         String?
  totalAmount       Decimal        @db.Decimal(18, 2)
  downPayment       Decimal        @default(0) @db.Decimal(18, 2)
  amountPaid        Decimal        @default(0) @db.Decimal(18, 2)
  outstandingAmount Decimal        @db.Decimal(18, 2)
  dueDate           DateTime
  status            InvoiceStatus  @default(DRAFT)
  paidAt            DateTime?
  notes             String?
  brand             Brand          @relation(fields: [brandId], references: [id], onDelete: Restrict)
  client            Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project           Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  transactions      Transaction[]
  attachments       Attachment[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([brandId, dueDate])
  @@index([status])
}

model VendorBill {
  id                String           @id @default(cuid())
  billNo            String           @unique
  billDate          DateTime
  vendorId          String
  brandId           String
  projectId         String?
  description       String
  totalAmount       Decimal          @db.Decimal(18, 2)
  amountPaid        Decimal          @default(0) @db.Decimal(18, 2)
  outstandingAmount Decimal          @db.Decimal(18, 2)
  dueDate           DateTime
  status            VendorBillStatus @default(DRAFT)
  paidAt            DateTime?
  notes             String?
  vendor            Vendor           @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  brand             Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  project           Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  transactions      Transaction[]
  attachments       Attachment[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([brandId, dueDate])
  @@index([status])
}

model Transaction {
  id               String              @id @default(cuid())
  transactionNo    String              @unique
  transactionDate  DateTime
  brandId          String
  transactionType  TransactionType
  categoryId       String
  accountId        String
  description      String
  clientId         String?
  vendorId         String?
  projectId        String?
  paymentMethodId  String?
  paymentStatus    PaymentStatus       @default(UNPAID)
  status           TransactionStatus   @default(POSTED)
  amountIn         Decimal             @default(0) @db.Decimal(18, 2)
  amountOut        Decimal             @default(0) @db.Decimal(18, 2)
  referenceNo      String?
  invoiceId        String?
  vendorBillId     String?
  notes            String?
  enteredById      String
  updatedById      String?
  brand            Brand               @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category         TransactionCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account          Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  client           Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  vendor           Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  project          Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  paymentMethod    PaymentMethod?      @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  invoice          Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  vendorBill       VendorBill?         @relation(fields: [vendorBillId], references: [id], onDelete: SetNull)
  enteredBy        User                @relation("TransactionEnteredBy", fields: [enteredById], references: [id], onDelete: Restrict)
  updatedBy        User?               @relation("TransactionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  attachments      Attachment[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([brandId, transactionDate])
  @@index([projectId, transactionDate])
  @@index([invoiceId])
  @@index([vendorBillId])
}

model Asset {
  id                      String              @id @default(cuid())
  assetCode               String              @unique
  name                    String
  brandId                 String
  category                AssetCategory
  purchaseDate            DateTime
  purchasePrice           Decimal             @db.Decimal(18, 2)
  usefulLifeMonths        Int
  monthlyDepreciation     Decimal             @db.Decimal(18, 2)
  accumulatedDepreciation Decimal             @default(0) @db.Decimal(18, 2)
  bookValue               Decimal             @db.Decimal(18, 2)
  condition               AssetCondition      @default(GOOD)
  notes                   String?
  brand                   Brand               @relation(fields: [brandId], references: [id], onDelete: Restrict)
  depreciations           AssetDepreciation[]
  attachments             Attachment[]
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@index([brandId, purchaseDate])
}

model AssetDepreciation {
  id                String   @id @default(cuid())
  assetId           String
  periodStart       DateTime
  periodEnd         DateTime
  amount            Decimal  @db.Decimal(18, 2)
  accumulatedAmount Decimal  @db.Decimal(18, 2)
  bookValueAfter    Decimal  @db.Decimal(18, 2)
  note              String?
  asset             Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@index([assetId, periodStart])
}

model Attachment {
  id           String         @id @default(cuid())
  kind         AttachmentKind
  fileName     String
  storagePath  String
  mimeType     String?
  fileSize     Int?
  transactionId String?
  invoiceId    String?
  vendorBillId String?
  assetId      String?
  uploadedById String?
  transaction  Transaction?   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  invoice      Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  vendorBill   VendorBill?    @relation(fields: [vendorBillId], references: [id], onDelete: Cascade)
  asset        Asset?         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  uploadedBy   User?          @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
}

model ActivityLog {
  id          String         @id @default(cuid())
  action      ActivityAction
  entityType  String
  entityId    String?
  description String
  metadata    Json?
  userId      String?
  brandId     String?
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  brand       Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}
